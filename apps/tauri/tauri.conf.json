{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XCPC Workstation",
  "version": "0.2.0",
  "identifier": "com.xcpc.workstation",
  "build": {
    "beforeBuildCommand": {
      "script": "node build-web.mjs",
      "cwd": "."
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "本地优先的 XCPC 工作站",
    "copyright": "Copyright XCPC Workstation contributors. Apache-2.0.",
    "resources": {
      "../../.fonts/cjk/": "fonts/cjk/",
      "licenses/": "licenses/",
      "../../LICENSE": "licenses/XCPC-Apache-2.0.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
